# ============================================
# ERP SYSTEM - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# MySQL (Direct Connection)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=erp

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=30d

# Server
PORT=3000
NODE_ENV=development

# Khi API chỉ mở qua Nginx/reverse proxy (Node không thấy IP khách qua TCP): TRUST_PROXY=1
# Chỉ bật nếu proxy tin cậy và gỡ/strip X-Forwarded-For giả từ Internet trước khi chuyển tới Node.
# TRUST_PROXY=

# Khôi phục mật khẩu Super Admin khi quên (POST /api/auth/super-admin-recovery + trang /super-admin-recovery)
# Đặt chuỗi ngẫu nhiên dài; KHÔNG commit giá trị thật. Hoặc dùng script: node backend/scripts/resetSuperAdminPassword.js
# SUPERADMIN_RESET_KEY=

# ZaloPilot app — POST /api/zalopilot/diagnostics/upload (header X-ZaloPilot-Token, KHÔNG public)
# Token bí mật ≥24 ký tự, chỉ nhúng trong app ZaloPilot — không để lộ trên web
# ZALOPILOT_UPLOAD_TOKEN=
# ZALOPILOT_UPLOAD_MAX_PER_IP=8          # upload/15 phút/IP (mọi attempt, kể 401)
# ZALOPILOT_UPLOAD_IP_WINDOW_MS=900000
# ZALOPILOT_UPLOAD_MAX_PER_DAY=80        # tối đa gói diagnostic/ngày (toàn server)
# ZALOPILOT_DIR=               # mặc định: {project}/public/zalopilot (bản cài + diagnostic upload)
# ZALOPILOT_DIAGNOSTICS_DIR=   # override riêng thư mục diagnostic; không set = dùng ZALOPILOT_DIR
